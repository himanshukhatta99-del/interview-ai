# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# MongoDB connection string (local or MongoDB Atlas)
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/interviewai
# Any long random string, used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Google Gemini API key: https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=your_gemini_api_key

# Optional (defaults shown)
GEMINI_MODEL=gemini-3-flash-preview
PORT=3000
# Frontend address allowed to call this API (CORS). Use your deployed URL in production.
CLIENT_URL=http://localhost:5173
# development | production  (production turns on secure cookies)
NODE_ENV=development
# Set to 1 when deployed behind a proxy (Render, Railway, Heroku...) so rate limiting sees real IPs
TRUST_PROXY=0
